{
  "outputDirectory": "out",
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/financial/loan-calculator",
      "destination": "/financial/bike-emi-calculator",
      "permanent": true
    },
    {
      "source": "/financial/inflation",
      "destination": "/financial/inflation-calculator",
      "permanent": true
    },
    {
      "source": "/financial/heloc",
      "destination": "/financial/heloc-calculator",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/css/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/js/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    }
  ]
}